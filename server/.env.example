# Copy this file to ".env" and fill in your own values
PORT=5000

# Local MongoDB (default). For MongoDB Atlas, paste your connection string here.
MONGO_URI=mongodb://127.0.0.1:27017/adrita_food_paradise

# Use any long random string as the JWT secret
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Frontend URL (Vite dev server) allowed to call this API
CLIENT_URL=http://localhost:5173
